# 이 파일을 복사해 .env 로 만들고 실제 값을 채운 뒤 사용하세요. (.env는 .gitignore에 의해 커밋되지 않습니다)
# IntelliJ 실행 설정(Run Configuration) 또는 셸 환경변수로 주입해도 됩니다.

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급받은 API Key
GEMINI_API_KEY=

# 로컬 docker-compose 기준 기본값. 원격 ES를 쓰는 경우에만 재정의하세요.
ELASTICSEARCH_URIS=http://localhost:9200

# 데모용 인메모리 계정(admin/user) 비밀번호. 미설정 시 SecurityConfig의 기본값(*-local-dev-only) 사용.
# 실제 서비스 배포 전 반드시 실제 IdP/JWT 인증으로 교체할 것 (CLAUDE.md 참고).
APP_SECURITY_DEMO_ADMIN_PASSWORD=
APP_SECURITY_DEMO_USER_PASSWORD=
